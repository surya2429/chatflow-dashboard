# ── WhatsApp Business API ─────────────────────────────────────────────────────
PHONE_NUMBER_ID=your_phone_number_id_here
WABA_ID=your_waba_id_here
ACCESS_TOKEN=your_graph_api_access_token_here
WEBHOOK_VERIFY_TOKEN=your_custom_verify_string_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── SIP (optional — enabling SIP disables Graph API calling endpoints) ────────
SIP_SERVER_HOSTNAME=sip.yourcompany.com
SIP_SERVER_PORT=5061
