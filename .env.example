# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Base URL the SPA calls for backend/ API routes. Leave as /api if you proxy
# the backend behind the same origin in production; point it at an absolute
# URL (e.g. http://localhost:8080/api) for local dev against `backend/`.
VITE_API_BASE_URL=/api

# ── Instagram API with Instagram Login ("Business Login") ──────────────────
# From your Meta App Dashboard → Instagram → API setup with Instagram login.
# Only the App ID is needed client-side — the App Secret stays in backend/.env,
# it's never sent to the browser.
VITE_INSTAGRAM_APP_ID=506519711888315
# Must exactly match a redirect URI whitelisted in the App Dashboard.
VITE_INSTAGRAM_REDIRECT_URI=https://www.feltso.com/instagramBusinessLoginSetup

# ── Razorpay billing (dev server only — see backend/src/billing) ───────────
# Put these in .env.local (gitignored), NOT in a VITE_ variable: the secret must
# never reach the browser. The dev server reads them to serve /api/billing.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=optional_until_you_register_a_webhook
# BILLING_GST_PERCENT=18
