# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Base URL the SPA calls for backend/ API routes. Leave as /api if you proxy
# the backend behind the same origin in production; point it at an absolute
# URL (e.g. http://localhost:8080/api) for local dev against `backend/`.
VITE_API_BASE_URL=/api

# ── Instagram API with Instagram Login ("Business Login") ──────────────────
# From your Meta App Dashboard → Instagram → API setup with Instagram login.
# Only the App ID is needed client-side — the App Secret stays in backend/.env,
# it's never sent to the browser.
VITE_INSTAGRAM_APP_ID=506519711888315
# Must exactly match a redirect URI whitelisted in the App Dashboard.
VITE_INSTAGRAM_REDIRECT_URI=https://www.feltso.com/instagramBusinessLoginSetup

# ── Razorpay billing (dev server only — see backend/src/billing) ───────────
# Put these in .env.local (gitignored), NOT in a VITE_ variable: the secret must
# never reach the browser. The dev server reads them to serve /api/billing.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=optional_until_you_register_a_webhook
# BILLING_GST_PERCENT=18
# BILLING_SUPPLIER_STATE_CODE=36
# BILLING_AUTOPAY_ENGINE=auto   # auto | token | subscription — auto = saved-card autopay up to ₹15,000, Razorpay Subscriptions above
# BILLING_LOGO_FILE=C:/path/to/logo.png   # optional; the built-in SmatBot logo is used otherwise
# BILLING_SELLER_NAME=Your Company Pvt Ltd
# BILLING_SELLER_ADDRESS=Registered office address, City, State PIN
# BILLING_SELLER_GSTIN=27XXXXXXXXXXXZX
# BILLING_SAC_CODE=998314
# BILLING_INVOICE_PREFIX=SB
# Login for /admin/plans (assign plans without payment). Unset = disabled
# BILLING_ADMIN_EMAIL=you@yourcompany.com
# BILLING_ADMIN_PASSWORD=choose-a-password
# BILLING_USAGE_KEY=long-random-string   # 16+ chars; services send it as x-usage-key to POST /api/billing/usage

# Inbox AI: encrypts the model API key saved from the dashboard. 16+ random characters; keep it stable or saved keys stop working
# AI_SETTINGS_SECRET=long-random-string

# Click-to-WhatsApp ads (leave unset = sample data). Token needs ads_management + ads_read
# META_AD_ACCOUNT_ID=1234567890
# META_PAGE_ID=1234567890   # the Facebook Page linked to your WhatsApp number
# META_ADS_ACCESS_TOKEN=EAAB...   # falls back to WA_ACCESS_TOKEN
# CTWA_WHATSAPP_NUMBER=+919876543210   # optional: pin the number ads open
# META_CAPI_DATASET_ID=   # optional: looked up from WA_BUSINESS_ACCOUNT_ID
# CTWA_PARTNER_AGENT=   # optional: partner name Meta assigned you
