# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://chatflow:chatflow@localhost:5432/chatflow_wa
PG_POOL_MAX=20

# ── Redis (BullMQ + dedupe + session cache) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Meta / WhatsApp Business Platform ───────────────────────────────────
# From Meta App Dashboard → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=1234567890123456
WA_BUSINESS_ACCOUNT_ID=1234567890123456
WA_GRAPH_API_VERSION=v20.0

# System User access token with whatsapp_business_messaging +
# whatsapp_business_management scopes. Use a long-lived System User token
# in production, never a personal/short-lived user token.
WA_ACCESS_TOKEN=EAAG...

# App Dashboard → Settings → Basic → App Secret. Used to verify
# X-Hub-Signature-256 on every inbound webhook call.
WA_APP_SECRET=your_meta_app_secret

# Arbitrary string you choose; must match what you enter in the Meta
# Dashboard's Webhook "Verify Token" field.
WA_WEBHOOK_VERIFY_TOKEN=change_me_to_a_long_random_string

# ── Queue tuning ─────────────────────────────────────────────────────────
MARKETING_QUEUE_CONCURRENCY=5
MARKETING_QUEUE_RATE_PER_SECOND=20
PRIORITY_QUEUE_CONCURRENCY=20

# ── Session ──────────────────────────────────────────────────────────────
SERVICE_WINDOW_HOURS=24

# ── Instagram API with Instagram Login ("Business Login") ──────────────────
# https://developers.facebook.com/docs/instagram-platform/instagram-api-with-instagram-login/business-login
# Meta App Dashboard → Instagram → API setup with Instagram login.
# Must match the frontend's VITE_INSTAGRAM_APP_ID (see repo root .env.example).
IG_APP_ID=506519711888315
# App Dashboard → Instagram → API setup with Instagram login → App secret.
# Never sent to the browser — only used server-side to redeem OAuth codes.
IG_APP_SECRET=your_instagram_app_secret
# Must exactly match a redirect URI whitelisted in the App Dashboard, and
# the frontend's VITE_INSTAGRAM_REDIRECT_URI.
IG_REDIRECT_URI=https://www.feltso.com/instagramBusinessLoginSetup
IG_GRAPH_API_VERSION=v21.0

# ── Razorpay billing ──────────────────────────────────────────────────────
# Dashboard → Account & Settings → API keys. rzp_test_… keys move no real money.
# The secret is used only on the server (Basic auth + checkout signature checks).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Needed only for webhooks: Dashboard → Webhooks → add https://<your-host>/api/billing/webhook
# with the subscription.* events, and put the secret you choose there here.
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# GST added on top of plan prices (prices are listed excl. GST).
BILLING_GST_PERCENT=18
# GST code of the state you are registered in (27 = Maharashtra). Same-state customers are
# invoiced CGST + SGST, everyone else IGST — the total is identical.
BILLING_SUPPLIER_STATE_CODE=27
# Printed on every GST invoice generated after a payment. Confirm the SAC code with your CA.
BILLING_SELLER_NAME=Your Company Pvt Ltd
BILLING_SELLER_ADDRESS=Registered office address, City, State PIN
# BILLING_SELLER_GSTIN=27XXXXXXXXXXXZX
BILLING_SAC_CODE=998314
BILLING_INVOICE_PREFIX=SB
