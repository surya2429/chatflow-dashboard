# ── Server ─────────────────────────────────────────────────────────────────
PORT=8090
NODE_ENV=development
LOG_LEVEL=info
# Production needs TLS: either terminate it here…
# TLS_CERT_PATH=/etc/ssl/agent-api/fullchain.pem
# TLS_KEY_PATH=/etc/ssl/agent-api/privkey.pem
# …or behind a TLS-terminating load balancer:
# TRUST_PROXY=true
# Browser origins allowed to call /api (the app itself doesn't need this).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Database ───────────────────────────────────────────────────────────────
# `npm run db:dev` prints this for the local embedded cluster.
DATABASE_URL=postgres://postgres:postgres@localhost:55433/chatflow_agent

# ── Auth ───────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# Shared with backend/ — it forwards normalized WhatsApp/Instagram webhook
# events to /internal/* with this key.
INTERNAL_API_KEY=change-me-internal-key-24-chars-min

# ── Presence / channels ────────────────────────────────────────────────────
PRESENCE_AWAY_AFTER_SECONDS=900
WHATSAPP_WINDOW_HOURS=24

# ── WebRTC ─────────────────────────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302
# coturn with `use-auth-secret` + `static-auth-secret=<TURN_SHARED_SECRET>`.
# Without TURN, calls fail on most mobile-carrier NATs.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=
CALL_RING_TIMEOUT_SECONDS=35

# ── Push (optional — logged instead of sent when unset) ────────────────────
# FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.chatflow.agent
# APNS_PRODUCTION=false

# ── Channel senders (optional — logged instead of sent when unset) ─────────
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# IG_ACCOUNT_ID=
# IG_ACCESS_TOKEN=
