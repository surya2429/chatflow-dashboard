{
  "name": "chatflow-agent-api",
  "version": "1.0.0",
  "description": "Live-agent backend for the ChatFlow mobile app — real auth, conversations/messages API, live events, push dispatch, and authenticated WebRTC signaling",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate up -m migrations -j sql",
    "migrate:down": "node-pg-migrate down -m migrations -j sql",
    "seed": "tsx scripts/seed.ts",
    "seed:history": "tsx scripts/seed-history.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "simulate": "tsx scripts/simulate-inbound.ts",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.9.6",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "node-pg-migrate": "^7.6.1",
    "pino-pretty": "^11.2.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
