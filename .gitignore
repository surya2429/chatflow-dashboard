# Dependencies
node_modules/

# Build output
dist/
build/

# Vite cache
node_modules/.vite/

# Claude configs (workspace-specific)
.claude/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Logs
*.log
logs/

# Dev-only bot number counter (see devBotsApi in vite.config.js)
.dev-bot-sequence.json

# Project snapshots — git already versions this tree; a 90MB zip of it
# would sit in history permanently for every future clone.
/claude.zip

# Local dev billing state (Razorpay subscription ids etc.)
.dev-billing.json

# Backups / archives (never commit)
*.zip
